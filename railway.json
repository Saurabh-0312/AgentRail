{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "yarn install --frozen-lockfile --ignore-engines"
  },
  "deploy": {
    "startCommand": "yarn workspace @agentrail/data-feed start:hosted",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE"
  }
}
