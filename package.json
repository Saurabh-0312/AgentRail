{
  "name": "agentrail",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "services/*",
    "indexer/subgraph",
    "agent",
    "web"
  ],
  "scripts": {
    "test:anchor": "ts-mocha -p ./tsconfig.json -t 1000000 \"tests/**/*.ts\"",
    "lint": "prettier */*.js \"*/**/*{.js,.ts}\" --check",
    "lint:fix": "prettier */*.js \"*/**/*{.js,.ts}\" -w",
    "demo:devnet": "node --env-file=.env scripts/devnet-e2e.ts",
    "demo:hedera": "node --env-file=.env scripts/hedera-e2e.ts"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.0",
    "@x402/evm": "~2.25",
    "@x402/svm": "~2.25"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1",
    "@modelcontextprotocol/sdk": "^1.12",
    "@solana/spl-token": "^0.4.9",
    "@types/bn.js": "^5.1.0",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^9.0.0",
    "@x402/hedera": "^2.25",
    "chai": "^4.3.4",
    "hono": "^4.13",
    "mocha": "^9.0.3",
    "prettier": "^2.6.2",
    "ts-mocha": "^10.0.0",
    "typescript": "^4.3.5",
    "vitest": "^4"
  }
}
