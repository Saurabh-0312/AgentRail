# Copy to .env and fill in the secrets. .env is gitignored and must never be committed.
# Public values (RPCs, addresses, IDs, slugs) are recorded here so we remember what we used.

# ---- Solana ----
SOLANA_RPC_URL=https://api.devnet.solana.com
ANCHOR_WALLET=~/.config/solana/id.json
SOLANA_WALLET_ADDRESS=55FJao825sA7rR9aKNtUEuGzN2gQNN9nZBw41WCWjvwb

# ---- Ethereum Sepolia (ENSv2) ----
# publicnode verified working; sepolia.drpc.org and rpc.sepolia.org were down at time of writing
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
SEPOLIA_CHAIN_ID=11155111
SEPOLIA_ADDRESS=0xAa4d6f945A57b972705712B5FbadE1Fd23521069
SEPOLIA_PRIVATE_KEY=

# ---- Base Sepolia (The Graph x402 pay-per-query settles in USDC on Base) ----
