# Copy to .env and fill in the secrets. .env is gitignored and must never be committed.
# Public values (RPCs, addresses, IDs, slugs) are recorded here so we remember what we used.

# ---- Solana ----
SOLANA_RPC_URL=https://api.devnet.solana.com
ANCHOR_WALLET=~/.config/solana/id.json
SOLANA_WALLET_ADDRESS=55FJao825sA7rR9aKNtUEuGzN2gQNN9nZBw41WCWjvwb

# ---- Ethereum Sepolia (ENSv2) ----
# publicnode verified working; sepolia.drpc.org and rpc.sepolia.org were down at time of writing
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
SEPOLIA_CHAIN_ID=11155111
SEPOLIA_ADDRESS=0xAa4d6f945A57b972705712B5FbadE1Fd23521069
SEPOLIA_PRIVATE_KEY=

# ---- Base Sepolia (The Graph x402 pay-per-query settles in USDC on Base) ----
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_SEPOLIA_CHAIN_ID=84532
BASE_SEPOLIA_ADDRESS=0xAa4d6f945A57b972705712B5FbadE1Fd23521069
BASE_SEPOLIA_PRIVATE_KEY=

# ---- Hedera testnet ----
HEDERA_NETWORK=testnet
HEDERA_JSON_RPC_URL=https://testnet.hashio.io/api
HEDERA_CHAIN_ID=296
HEDERA_ACCOUNT_ID=0.0.4863756
HEDERA_EVM_ADDRESS=0x0f072339a79e72a78a0535bb9132228c8b8b1ff0
HEDERA_PRIVATE_KEY=

# ---- x402 facilitators ----
BLOCKY402_API_KEY=

# ---- The Graph ----
SUBGRAPH_SLUG=agentrail
SUBGRAPH_NETWORK=sepolia
SUBGRAPH_STUDIO_DEPLOY_KEY=
GRAPH_API_KEY=
# SUBSTREAMS_API_TOKEN comes from `substreams auth` (The Graph Market), written to .substreams.env
SUBSTREAMS_API_TOKEN=

# ---- LLM (agent) — one is enough; tried in this order. Gemini and Groq have free tiers ----
# Gemini free-tier quotas are PER MODEL, so the default is gemini-3.5-flash-lite: the full flash
# models allow ~20 requests/day and one agent run exhausts them. AGENT_MODEL overrides.
# Their 429 says "retry in 15s" but the quota is per day; it resets at midnight Pacific.
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
HEDERA_SELLER_ACCOUNT_ID=0.0.10440535
HEDERA_TESTNET_USDC=0.0.429274

# ---- Fresh deployer for Sepolia / Base Sepolia (key lives only in .env) ----
DEPLOYER_ADDRESS=0xAa4d6f945A57b972705712B5FbadE1Fd23521069
DEPLOYER_PRIVATE_KEY=

# ---- Phase 1 deployments (public) ----
# Solana devnet program: GcYqRmrRko3WbKNuGarDTbmRF1GcdeHzc3eV37gtM4Bj
DEVNET_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# Sepolia ENSv2: agentrail.eth -> AgentRailRegistry (subregistry) + PermissionedResolver proxy
# CAUTION: 0x68822ce9... is AgentRailRegistry on SEPOLIA only. The same address is EvmMandate on
# Hedera testnet and Base Sepolia (deployer nonce 0 on all three chains). Always pair address + chain.
REGISTRY_ADDRESS=0x68822ce9109D9d71e99b07703cF6c851D0229AA9
RESOLVER_ADDRESS=0xbfce4e394832c879fd2d95dae4F02259AFd23C16
# databot.agentrail.eth: the agent's EVM key owns the subname (no roles), Solana key is in rail.agent.solana
AGENT_EVM_ADDRESS=0x6FB563E9Af8a1011f846842793d73bA12AA91875
AGENT_EVM_PRIVATE_KEY=
RAIL_AGENT_SOLANA=4XwCs2E3cQcK4vEi5tE2Gi6uCKgXL1XaSyhn8LukQddV
RAIL_MANDATE_PDA=7TuT4p76fPgGbxY6PHLVjJiX7aX4QUCiPX7TPYv6L69a
# Random bytes32 used for the ENS commit/reveal registration
ENS_COMMIT_SECRET=

# ---- data-feed (services/data-feed) ----
# Seller / payTo: created by scripts/hedera-setup.ts with unlimited automatic token associations
HEDERA_SELLER_PRIVATE_KEY=
HEDERA_SELLER_EVM_ADDRESS=0x11cce8739676df7701d99346fd069abde9648fda
BLOCKY402_URL=https://api.testnet.blocky402.com
# HTS USDC 0.0.429274 by default; 0.0.0 prices in HBAR
FEED_ASSET=0.0.429274
FEED_UNIT_PRICE=10000
FEED_MAX_SYMBOLS=5
# Live on Render (free tier sleeps when idle; first request after a pause takes ~1 min)
FEED_PUBLIC_URL=https://agentrail-data-feed.onrender.com

# ---- EvmMandate: one artifact, two chains (same deployer nonce => same address) ----
# CAUTION: this address is EvmMandate ONLY on Hedera testnet (296) and Base Sepolia (84532).
# On Ethereum Sepolia the identical address is the AgentRailRegistry, a different contract.
EVM_MANDATE_HEDERA=0x68822ce9109D9d71e99b07703cF6c851D0229AA9
EVM_MANDATE_BASE_SEPOLIA=0x68822ce9109D9d71e99b07703cF6c851D0229AA9

# ---- ERC-8004 identity (Sepolia) ----
ERC8004_IDENTITY_REGISTRY=0x8004A818BFB912233c491871b3d84c89A494BD9e
ERC8004_AGENT_ID=10190
# databot.agentrail.eth namehash, the join key shared by the ENS subname, the Solana PDA and the EVM mandates
RAIL_NODE=0x320d329cfd5eb36600e8a276ddaa5dd31e6ff7aad7637c8dfb3504725076d4ae
# ---- Gate 2 demo ----
FEED_URL=https://agentrail-data-feed.onrender.com/price/SOL,HBAR
HCS_AUDIT_TOPIC_ID=

# ---- Phase 3: discovery. The demo starts from names only; every URL below comes from ENS records ----
AGENT_ENS_NAME=databot.agentrail.eth
SERVICE_ENS_NAMES=feed.agentrail.eth,graph.agentrail.eth
ROGUE_ENS_NAME=rogue.agentrail.eth
# Service names on Sepolia ENSv2 (owner: deployer): feed.agentrail.eth -> hedera:testnet,
# graph.agentrail.eth -> eip155:84532 (The Graph testnet x402 gateway), rogue.agentrail.eth -> our own
# feed's /demo/unlisted route: a valid 402 whose payee (0.0.98) is deliberately NOT on rail.allowed,
# so the refusal is NotOnAllowList every time with no third party in the loop.
# rail.allowed on databot.agentrail.eth: Solana ATA 2/5 USDC, Hedera seller 0.03/0.05 USDC,
# Base Graph payee perTx 100 / total 500 units (headroom for facilitator retries; each consumes budget)

# ---- Phase 4: the shared schema, three sources (public endpoints; the API key is GRAPH_API_KEY) ----
# Subgraph Studio (not published to the network; queried with an API key, the qualifying path)
SUBGRAPH_SEPOLIA_URL=https://api.studio.thegraph.com/query/120234/agentrail/v0.1.0
SUBGRAPH_BASE_URL=https://api.studio.thegraph.com/query/120234/agentrail-base/v0.1.0
# Solana devnet Substreams: streamed from a Graph provider with the token from `substreams auth` (.substreams.env)
SUBSTREAMS_ENDPOINT=devnet.sol.streamingfast.io:443
# Published Substreams packages (substreams.dev registry)
SUBSTREAMS_PACKAGE=agentrail-mandates@v0.1.0
SUBSTREAMS_TOKEN_PACKAGE=agentrail-token-activity@v0.1.0

# ---- Phase 6: the dashboard (web/) and the MCP server (packages/mcp-server) ----
# The web app reads these on the SERVER only (route handlers); nothing is prefixed NEXT_PUBLIC_ and
# `yarn workspace @agentrail/web check:bundle` fails the build if a key reaches the client bundle.
# Locally it loads this repo's .env; on Vercel the same names go in the project's environment.
# Needed: GRAPH_API_KEY, SEPOLIA_RPC_URL, BASE_SEPOLIA_RPC_URL, HEDERA_JSON_RPC_URL, SOLANA_RPC_URL,
# SUBGRAPH_SEPOLIA_URL, SUBGRAPH_BASE_URL (all already above).
# The Solana leg of the feed is a committed snapshot: web/data/solana-activity.json, refreshed with
# `yarn sink:solana && yarn workspace @agentrail/web snapshot:solana`; its syncedAt is shown in the UI.
# MCP server (optional): point get_history at the snapshot instead of the local sink for hosted use
AGENTRAIL_SOLANA_SNAPSHOT=
# The live dashboard (Vercel, root directory web/, server-side env only)
WEB_URL=https://agentrail-delta.vercel.app

# ---- GAP 3: "Activate Agent" on the deployed dashboard (server-side only, never NEXT_PUBLIC_) ----
# The button runs one monitor pass through the agent-only runtime (agent/src/runtime-agent.ts): the
# agent's own keys, the mandates the owner already issued, Solana read-only. On Vercel add, next to
# the seven web variables above: GEMINI_API_KEY (or GROQ_API_KEY), HEDERA_ACCOUNT_ID and
# HEDERA_PRIVATE_KEY (the agent's x402 payer on Hedera), optionally AGENT_EVM_PRIVATE_KEY (Base).
# Never the deployer key: the runtime issues nothing and the owner never signs from a button.
# ALICE_WALLET is the EVM wallet the monitor watches (a public address; defaults to vitalik.eth).
ALICE_WALLET=0xd8dA6BF26964aF9D7eEd9e03E53415D37aA96045
